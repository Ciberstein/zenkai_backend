# Servicio "worker" de Railway: convierte a HLS los videos subidos desde el admin.
# Es la imagen de la API mas ffmpeg. En Railway: crea un segundo servicio desde este
# mismo repositorio y define RAILWAY_DOCKERFILE_PATH=Dockerfile.worker.
FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

ENV NODE_ENV=production

CMD ["node", "worker/index.js"]
