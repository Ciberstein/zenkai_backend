DB_DIALECT=postgres
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=5432

FRONTEND_DOMAIN=http://localhost:5173

# development / production
NODE_ENV=development

PORT=3010

JWT_SECRET_SEED=
JWT_EXPIRE_IN=15m
JWT_REFRESH_EXPIRE_IN=30d

# API oficial de MyAnimeList. Se registra la app en
# https://myanimelist.net/apiconfig (gratis) y se pega aqui el Client ID.
# Es la fuente preferente del backfill; sin ella se recurre a Jikan.
MAL_CLIENT_ID=

# Jikan (https://docs.api.jikan.moe)
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_CACHE_TTL=86400

REDIS_URL=redis://localhost:6379

# Cloudflare R2 (solo para scripts/publish.episode.js). Credenciales: R2 → Manage API tokens.
# R2_PUBLIC_URL es la URL publica del bucket (dominio propio o r2.dev), sin barra final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Opcional. Por defecto los originales subidos desde el admin esperan en el mismo
# bucket (carpeta incoming/, bloqueada en el dominio publico). Define este para usar
# otro bucket, privado, solo para ellos.
R2_UPLOAD_BUCKET=
# Solo para el servicio worker: segundos entre consultas de la cola (10 por defecto).
WORKER_POLL_SECONDS=10
